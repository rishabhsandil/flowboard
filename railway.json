{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "dotnet publish src/FlowBoard.Api/FlowBoard.Api.csproj -c Release -o out"
  },
  "deploy": {
    "startCommand": "dotnet out/FlowBoard.Api.dll",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
