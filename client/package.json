    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.10",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.23.1",
