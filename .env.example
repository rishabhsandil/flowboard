# API (Railway env vars; in dev, put these in src/FlowBoard.Api/appsettings.Development.json)
ConnectionStrings__Neon=postgresql://user:pass@ep-xxx.neon.tech/flowboard?sslmode=require
Jwt__Secret=replace-with-64-char-random-string
Jwt__RefreshSecret=replace-with-different-64-char-random-string
ASPNETCORE_ENVIRONMENT=Development
PORT=8080

# Web (Vercel env vars)
VITE_API_URL=http://localhost:8080/api
