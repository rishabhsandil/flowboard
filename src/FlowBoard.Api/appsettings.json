{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Neon": ""
  },
  "Jwt": {
    "Secret": "",
    "RefreshSecret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Email": {
    "Provider": "log",
    "FromAddress": "no-reply@flowboard.local",
    "FromName": "FlowBoard",
    "ResendApiKey": "",
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Forgot": {
    "EchoTokenInResponse": false,
    "PerEmailCooldownSeconds": 60,
    "Cleanup": {
      "Enabled": true,
      "IntervalSeconds": 21600,
      "RetentionDays": 7
    }
  }
}
